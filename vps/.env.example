# --- GitHub ---
# Personal access token (classic) with "repo" scope. Create in GitHub Settings
# -> Developer settings -> Personal access tokens.
GITHUB_TOKEN=ghp_xxxxxxxx
# Random secret shared with the GitHub webhook (generate: openssl rand -hex 32).
WEBHOOK_SECRET=change-me-to-a-random-string
WEBHOOK_PORT=8080

# --- Workflow ---
# Base branch that receives feature PRs (see AGENTS.md §15).
PR_BASE_BRANCH=testing
# Comment command that triggers the pipeline on an issue.
TRIGGER_COMMAND=/sdd
# Repos this worker is allowed to process.
ALLOWED_REPOS=IgnaGrego/sistema-banco

# --- Git identity used for commits ---
GIT_USER_NAME=SDD Bot
GIT_USER_EMAIL=sdd-bot@localhost

# --- Model (optional) ---
# Leave MODEL empty to use opencode's configured default.
# Ejemplo con DeepSeek:
# MODEL=deepseek/deepseek-chat
# Provider key(s) required by your model:
# DEEPSEEK_API_KEY=sk-...
