# --- GitHub ---
# Personal access token (classic) with "repo" scope. Create in GitHub Settings
# -> Developer settings -> Personal access tokens.
GITHUB_TOKEN=ghp_xxxxxxxx
# Random secret shared with the GitHub webhook (generate: openssl rand -hex 32).
WEBHOOK_SECRET=change-me-to-a-random-string
WEBHOOK_PORT=8080

# --- Workflow ---
# Base branch that receives feature PRs (see AGENTS.md §15).
PR_BASE_BRANCH=testing
# Comment command that triggers the pipeline on an issue.
TRIGGER_COMMAND=/sdd
# Encolar el pipeline al abrir cualquier issue? (false = solo via /sdd comment)
TRIGGER_ON_OPEN=false
# Repos this worker is allowed to process.
ALLOWED_REPOS=IgnaGrego/sistema-banco

# --- Git identity used for commits ---
GIT_USER_NAME=SDD Bot
GIT_USER_EMAIL=sdd-bot@localhost

# --- Model ---
# Tu provider es OpenCode Go (suscripción). ID del modelo que usás:
MODEL=opencode-go/deepseek-v4-flash
# La API key de OpenCode Go NO se pone acá. Se autentica dentro del
# contenedor del worker una sola vez con:
#   docker compose exec -it worker opencode auth login
# (seleccionar "OpenCode Go" y pegar la key; queda persistida en el volumen).
#
# Otras keys de providers directos (solo si usás esos providers):
# DEEPSEEK_API_KEY=sk-...
