{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true, "tail_turns": 15 },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny"
    },
    "task": "allow",
    "todowrite": "allow"
  }
}
